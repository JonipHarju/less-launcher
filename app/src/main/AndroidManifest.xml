<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
      LauncherApps.getActivityList still obeys package visibility. Declaring the
      MAIN/LAUNCHER intent is how a home app sees every launchable activity without
      QUERY_ALL_PACKAGES.

      Setup asks the platform which app dials, messages, takes a photo or opens a web
      page, so the Favorites it proposes are resolved by intent rather than by package
      name. Messaging and browser are MAIN activities the first filter already covers;
      dialling and the camera are not, so they are named on their own.

      Tapping the clock and date tries their specific intents first, then the platform's
      clock or calendar category. Those actions and categories are not all launchable
      activities, so the focused queries make their handlers visible without a permission.

      Uninstall from Curation asks the package installer to delete one package. The delete
      action is not a LAUNCHER intent, so it needs its own declaration; without it the request
      resolves to nothing and the menu closes as if it had been accepted.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CLOCK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="com.android.calendar"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <!--
      The agent is declared for its restore callback alone; fullBackupOnly keeps the transfer
      the ordinary automatic backup of the files the extraction rules name.
    -->
    <application
        android:allowBackup="true"
        android:backupAgent=".launcher.ConfigurationRestoreAgent"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Less">
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <!--
              HOME offers Less as a home app. LAUNCHER gives it an icon in whichever launcher is
              currently the home app, which is the only way a user who has never opened the
              default-apps screen can reach Less at all — see ADR-0008.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
